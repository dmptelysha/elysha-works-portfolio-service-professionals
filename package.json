{
  "name": "elysha-works-service-professionals-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:booking-config": "node scripts/generate-booking-config.mjs",
    "predev": "npm run generate:booking-config",
    "dev": "next dev",
    "prepreview": "npm run generate:booking-config",
    "preview": "next dev",
    "prebuild": "npm run generate:booking-config",
    "build": "next build",
    "start": "next start",
    "firebase:serve": "firebase emulators:start --only hosting",
    "firebase:test-rules": "firebase emulators:exec --only firestore \"node --test tests/firestore-rules.test.mjs\"",
    "test:supabase:static": "node --test tests/supabase-migrations-static.test.mjs",
    "test:supabase:db": "supabase test db",
    "lint": "eslint src next.config.ts eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:static && npm run test:unit",
    "test:static": "node --test tests/live-copy.test.mjs tests/booking-config.test.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:booking-config": "node --test tests/booking-config.test.mjs",
    "test:legacy": "node --test tests/portfolio.test.mjs",
    "test:live-browser": "node tests/live-browser-check.mjs",
    "check:static": "node --check script.js && node --test tests/portfolio.test.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "firebase": "^12.19.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
